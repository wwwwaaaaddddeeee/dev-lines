{
  "manifest_version": 3,
  "name": "dev-lines",
  "version": "0.2.0",
  "description": "Layout guides, depth-colored outlines, labels & distances on any page — toggle with the popup or ⌘/Ctrl+Shift+L.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "dev-lines"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle": {
      "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" },
      "description": "Toggle dev-lines on the current page"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["<all_urls>"]
}
